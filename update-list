#!/bin/sh
# update-list - rebuild distrusted.tsv. Maintainer tool: the only part of trust-audit that
# uses the network (the audit itself never does). Run it, review `git diff`, commit.
#
# Inputs:
#   sources/curated.tsv     curated, frozen incident data (eMudhra 2026, DigiNotar ... TrustCor), edited by hand
#   Mozilla / CCADB         roots listed in the "removed roots" report            (kind "removed")
#   Mozilla / CCADB         roots still included but with a "Distrust for TLS
#                           After" date                                           (kind "partial")
#   Mozilla / CCADB         roots the full records report marks "Removed" - the
#                           removed-roots report above omits some (kind "removed")
# Earlier sources win when a fingerprint appears twice.
#
# Output columns (tab-separated): sha256, kind, label, reason, ref (URL of the incident or bug; may be empty).
# Usage: update-list [output]      (default: distrusted.tsv next to this script)
# Needs: curl, awk.

set -eu
LC_ALL=C
export LC_ALL

here=$(cd "$(dirname "$0")" && pwd)
out=${1:-$here/distrusted.tsv}
CCADB=https://ccadb.my.salesforce-sites.com/mozilla

for c in curl awk sort; do command -v "$c" >/dev/null 2>&1 || { echo "update-list: $c is required" >&2; exit 2; }; done
tmp=$(mktemp -d "${TMPDIR:-/tmp}/trust-audit-upd.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

curl -fsSL --max-time 60 "$CCADB/RemovedCACertificateReportCSVFormat" -o "$tmp/removed.csv"
curl -fsSL --max-time 60 "$CCADB/IncludedCACertificateReportPEMCSV" -o "$tmp/included.csv"
curl -fsSL --max-time 280 "https://ccadb.my.salesforce-sites.com/ccadb/AllCertificateRecordsCSVFormatV5" -o "$tmp/all.csv"

# csv_cols "Header A|Header B|..." FILE -> TSV of those columns, looked up BY HEADER NAME so a
# reordered report cannot silently shift columns. RFC 4180: quoted fields may hold newlines.
csv_cols() {
  awk -v want="$1" '
    function split_csv(rec, f,   i, c, q, n, cur) {
      n = 0; cur = ""; q = 0
      for (i = 1; i <= length(rec); i++) {
        c = substr(rec, i, 1)
        if (q) { if (c == "\"") { if (substr(rec, i + 1, 1) == "\"") { cur = cur "\""; i++ } else q = 0 } else cur = cur c }
        else if (c == "\"") q = 1
        else if (c == ",") { f[++n] = cur; cur = "" }
        else cur = cur c
      }
      f[++n] = cur
      return n
    }
    BEGIN { nw = split(want, w, "|") }
    { rec = rec (rec == "" ? "" : "\n") $0; t = rec; if ((gsub(/"/, "", t)) % 2) next
      n = split_csv(rec, f); rec = ""
      if (++row == 1) {
        for (i = 1; i <= n; i++) idx[f[i]] = i
        for (i = 1; i <= nw; i++) if (!(w[i] in idx)) { print "update-list: column not found in CCADB report: " w[i] > "/dev/stderr"; bad = 1; exit 1 }
        next
      }
      line = ""
      for (i = 1; i <= nw; i++) { v = f[idx[w[i]]]; gsub(/[\t\n\r]+/, " ", v); line = line (i > 1 ? "\t" : "") v }
      print line }
    END { if (bad) exit 1 }' "$2"
}

csv_cols "SHA-256 Fingerprint|Root Certificate Name|NSS Release When Removed|Removal Bug No. or Date" "$tmp/removed.csv" |
  awk -F'\t' '
    { ref = ""
      if ($4 ~ /^https?:\/\//) ref = $4                                     # a URL
      else if ($4 ~ /^[0-9][0-9][0-9][0-9][0-9]+$/) ref = "https://bugzilla.mozilla.org/show_bug.cgi?id=" $4   # a bare bug number
      printf "%s\tremoved\t%s\tremoved from Mozilla NSS in %s\t%s\n", $1, $2, $3, ref }' >"$tmp/removed.tsv"
csv_cols "SHA-256 Fingerprint|Common Name or Certificate Name|Distrust for TLS After Date" "$tmp/included.csv" |
  awk -F'\t' '$3 != "" { printf "%s\tpartial\t%s\tMozilla distrusts TLS certificates issued after %s (a flat bundle cannot express the date)\t\n", $1, $2, $3 }' >"$tmp/after.tsv"

csv_cols "Certificate Record Type|Mozilla Status|SHA-256 Fingerprint|Certificate Name" "$tmp/all.csv" |
  awk -F'\t' '$1 ~ /^Root/ && $2 == "Removed" { printf "%s\tremoved\t%s\tno longer in Mozilla'"'"'s root store (CCADB status: Removed)\t\n", $3, $4 }' >"$tmp/allremoved.tsv"

nrem=$(awk 'END { print NR }' "$tmp/removed.tsv")
nall=$(awk 'END { print NR }' "$tmp/allremoved.tsv")
if [ "$nrem" -lt 50 ] || [ "$nall" -lt 100 ]; then
  echo "update-list: only $nrem + $nall removed roots parsed, refusing to write (format change?)" >&2
  exit 1
fi

now=$(date +%s)
{
  printf '# generated=%s epoch=%s\n' "$(date -u +%Y-%m-%d)" "$now"
  printf '# sha256\tkind\tlabel\treason\tref\n'
  grep -hv '^#' "$here/sources/curated.tsv" "$tmp/removed.tsv" "$tmp/after.tsv" "$tmp/allremoved.tsv" |
    awk -F'\t' 'BEGIN { OFS = "\t" } { $1 = toupper($1) }
      length($1) != 64 || $1 ~ /[^0-9A-F]/ { printf "update-list: skipped an entry with an invalid fingerprint: %s (%s)\n", $3, $1 > "/dev/stderr"; next }
      !seen[$1]++ { if (NF < 5) $5 = ""; print }'
} >"$tmp/new.tsv"

mv "$tmp/new.tsv" "$out"
echo "wrote $out: $(grep -vc '^#' "$out") fingerprints"
